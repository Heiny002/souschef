# Secrets — real API keys live here, never commit (use Secrets.example.xcconfig as template)
Secrets.xcconfig

# Signing — your Apple Team ID / bundle id live here, never commit
# (use Signing.example.xcconfig as template). Keeps device signing out of the
# tracked project file so pulls don't conflict on project.pbxproj.
Signing.xcconfig

# Instagram session cookies for the desktop debug tool (tools/ig_extract.py).
# Contains a live login session — treat like a password, never commit.
cookies.txt
*.cookies.txt

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# CocoaPods / Carthage (if ever used)
Pods/
Carthage/Build/

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output
